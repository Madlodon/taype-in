# Copier ce fichier en .env puis ajuster les valeurs.

# Service PostgreSQL de docker-compose.yml
# Utilisateur créé au premier démarrage du conteneur
POSTGRES_USER=taype_in
# Mot de passe de cet utilisateur
POSTGRES_PASSWORD=change-me
# Nom de la base créée au premier démarrage
POSTGRES_DB=taype_in
# Port exposé sur l'hôte (changer si 5432 est déjà pris)
POSTGRES_PORT=5432

# Chaîne de connexion utilisée par l'application et Drizzle
DATABASE_URL=postgres://taype_in:change-me@localhost:5432/taype_in

# Clé secrète ajoutée au hachage des mots de passe (openssl rand -hex 32).
# Ne jamais la changer ni la perdre : tous les mots de passe deviendraient invalides.
# La sauvegarder ailleurs que sur le serveur.
PASSWORD_PEPPER=change-me

# Port HTTP du serveur Next + Socket.IO (server.ts). 3000 par défaut.
PORT=3000

# Optionnel : connexion avec Discord et GitHub (AUTH-2). Sans ses deux clés, un
# fournisseur n'est pas offert. URL de rappel à inscrire chez le fournisseur :
# <adresse du site>/auth/discord/callback et <adresse du site>/auth/github/callback
# Discord : https://discord.com/developers/applications → OAuth2
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# GitHub : Settings → Developer settings → OAuth Apps
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Optionnel : adresse publique du site, utilisée dans l'URL de rappel OAuth.
# Par défaut, l'adresse de la requête (suffisant en développement).
# APP_URL=https://laniproject.dev

# Optionnel : probabilité (0 à 1) qu'un tir soit un but pendant une course.
# 0,5 par défaut ; 0 désactive les buts (utilisé par les tests E2E).
# GOAL_CHANCE=0.5

# Production seulement (compose.prod.yml) : domaine servi en HTTPS par Caddy.
# Mettre un mot de passe sans caractères spéciaux (ex. : openssl rand -hex 24),
# car il est inséré tel quel dans DATABASE_URL.
DOMAIN=laniproject.dev
