# Copier ce fichier en .env puis ajuster les valeurs.

# Service PostgreSQL de docker-compose.yml
POSTGRES_USER=taype_in
POSTGRES_PASSWORD=change-me
POSTGRES_DB=taype_in
# Port exposé sur l'hôte (changer si 5432 est déjà pris)
POSTGRES_PORT=5432

# Chaîne de connexion utilisée par l'application et Drizzle
DATABASE_URL=postgres://taype_in:change-me@localhost:5432/taype_in
